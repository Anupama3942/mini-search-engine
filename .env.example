# Mini Search Engine - Environment Variables Example Template
# Copy this file to .env for local overrides

# Application Environment Profile: development | testing | production
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=5000

# Logging & Observability
LOG_LEVEL=INFO
LOG_QUERIES=true

# Search & Ranking Defaults
DEFAULT_RANKING_ALGORITHM=bm25
DEFAULT_TOP_K=10
MAX_TOP_K=100
MAX_QUERY_LENGTH=500
DEFAULT_PAGE_SIZE=10
CANDIDATE_POOL_SIZE=50
SEARCH_TIMEOUT_SECONDS=2.0

# Feature Flags
ENABLE_SEMANTIC=true
ENABLE_HYBRID=true
ENABLE_LTR=true
ENABLE_ADVANCED_PIPELINES=true

# BM25 Parameters
BM25_K1=1.2
BM25_B=0.75

# Hybrid Search Parameters
HYBRID_ALPHA=0.5

# Paths (defaults to local workspace folders)
# DATA_DIR=./documents
# MODELS_DIR=./models
# ANALYTICS_DB_PATH=./analytics.db

# Security & CORS
ALLOWED_ORIGINS=*
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
